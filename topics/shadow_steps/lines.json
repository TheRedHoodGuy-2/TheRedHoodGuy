[
 {
  "i": 0,
  "text": "In this town, every lie makes your shadow step away from you.",
  "s": 0.11,
  "e": 2.45
 },
 {
  "i": 1,
  "text": "You see, ten lies, ten steps, and your shadow leaves for good.",
  "s": 2.59,
  "e": 4.97
 },
 {
  "i": 2,
  "text": "And once it's gone, nobody can see you anymore.",
  "s": 5.19,
  "e": 6.69
 },
 {
  "i": 3,
  "text": "So liars here are easy to spot.",
  "s": 6.97,
  "e": 8.17
 },
 {
  "i": 4,
  "text": "My teacher's shadow sits two desks behind her.",
  "s": 8.35,
  "e": 10.15
 },
 {
  "i": 5,
  "text": "Our mailman says \"Nice dog!\" every single day.",
  "s": 10.27,
  "e": 12.09
 },
 {
  "i": 6,
  "text": "His shadow lives at the end of the street.",
  "s": 12.29,
  "e": 13.41
 },
 {
  "i": 7,
  "text": "And Grandpa once told Grandma her meatloaf was amazing.",
  "s": 13.75,
  "e": 15.65
 },
 {
  "i": 8,
  "text": "We still set him a plate.",
  "s": 15.85,
  "e": 16.71
 },
 {
  "i": 9,
  "text": "Just in case.",
  "s": 16.81,
  "e": 17.29
 },
 {
  "i": 10,
  "text": "But lying isn't my problem.",
  "s": 17.53,
  "e": 18.61
 },
 {
  "i": 11,
  "text": "My problem is my sister, Mia.",
  "s": 18.81,
  "e": 19.97
 },
 {
  "i": 12,
  "text": "Mia lies all day.",
  "s": 20.27,
  "e": 21.07
 },
 {
  "i": 13,
  "text": "To Mom. To teachers. To the dog.",
  "s": 21.25,
  "e": 22.59
 },
 {
  "i": 14,
  "text": "And her shadow never moves.",
  "s": 22.87,
  "e": 23.89
 },
 {
  "i": 15,
  "text": "Not one step.",
  "s": 24.09,
  "e": 24.63
 },
 {
  "i": 16,
  "text": "So Mom thinks Mia is perfect.",
  "s": 24.87,
  "e": 25.91
 },
 {
  "i": 17,
  "text": "Me? I never take off my red hoodie.",
  "s": 26.27,
  "e": 27.71
 },
 {
  "i": 18,
  "text": "Mia never takes out her ponytail.",
  "s": 27.85,
  "e": 28.77
 },
 {
  "i": 19,
  "text": "Until Tuesday.",
  "s": 28.77,
  "e": 29.55
 },
 {
  "i": 20,
  "text": "Grandma's vase hit the floor.",
  "s": 29.79,
  "e": 30.87
 },
 {
  "i": 21,
  "text": "Mia pointed right at me.",
  "s": 31.13,
  "e": 32.01
 },
 {
  "i": 22,
  "text": "\"He did it,\" she said.",
  "s": 32.13,
  "e": 32.97
 },
 {
  "i": 23,
  "text": "And my shadow took a step away.",
  "s": 33.13,
  "e": 34.31
 },
 {
  "i": 24,
  "text": "\"I didn't!\" I yelled.",
  "s": 34.53,
  "e": 35.33
 },
 {
  "i": 25,
  "text": "But Mom didn't even look at me.",
  "s": 35.53,
  "e": 36.55
 },
 {
  "i": 26,
  "text": "\"He ate the last cookie too,\" Mia said.",
  "s": 36.73,
  "e": 38.41
 },
 {
  "i": 27,
  "text": "Step.",
  "s": 38.99,
  "e": 38.99
 },
 {
  "i": 28,
  "text": "\"He said you look old, Mom.\"",
  "s": 39.21,
  "e": 40.41
 },
 {
  "i": 29,
  "text": "Step.",
  "s": 40.69,
  "e": 41.05
 },
 {
  "i": 30,
  "text": "Seven steps. Eight.",
  "s": 41.33,
  "e": 42.09
 },
 {
  "i": 31,
  "text": "My hands were going see-through.",
  "s": 42.39,
  "e": 42.91
 },
 {
  "i": 32,
  "text": "I looked down at my shadow.",
  "s": 43.59,
  "e": 44.43
 },
 {
  "i": 33,
  "text": "It had a ponytail.",
  "s": 44.69,
  "e": 45.47
 },
 {
  "i": 34,
  "text": "Then I looked at Mia's shadow.",
  "s": 45.69,
  "e": 46.63
 },
 {
  "i": 35,
  "text": "It had a hood.",
  "s": 46.85,
  "e": 47.37
 },
 {
  "i": 36,
  "text": "That was never her shadow.",
  "s": 47.63,
  "e": 48.73
 },
 {
  "i": 37,
  "text": "It was mine.",
  "s": 48.83,
  "e": 49.35
 },
 {
  "i": 38,
  "text": "Every lie Mia ever told was walking MY shadow out the door.",
  "s": 49.67,
  "e": 52.33
 },
 {
  "i": 39,
  "text": "Nine steps.",
  "s": 52.65,
  "e": 53.07
 },
 {
  "i": 40,
  "text": "I grabbed Mom's arm.",
  "s": 53.37,
  "e": 54.23
 },
 {
  "i": 41,
  "text": "She looked right through me.",
  "s": 54.49,
  "e": 55.53
 },
 {
  "i": 42,
  "text": "Mia smiled, and leaned in close.",
  "s": 55.75,
  "e": 57.09
 },
 {
  "i": 43,
  "text": "\"Mom,\" she whispered, \"I love you.\"",
  "s": 57.09,
  "e": 58.83
 }
]